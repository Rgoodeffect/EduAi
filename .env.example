# -----------------------------------------------------------------------------
# EduAi — environment configuration template
# Copy to .env for local dev (`cp .env.example .env`) and fill in real values.
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# --- Database (PostgreSQL) ----------------------------------------------------
DATABASE_URL="postgresql://eduai:eduai_password@localhost:5432/eduai?schema=public"

# --- Redis / BullMQ ------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- JWT Auth ------------------------------------------------------------------
# Generate strong random secrets, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET="change-me-access-secret-change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret-change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- File storage ----------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/uploads"
MAX_UPLOAD_SIZE_MB=50

# --- Ollama (local LLM runtime) ------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="qwen3:8b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# --- ChromaDB (vector store) ---------------------------------------------------
CHROMA_URL="http://localhost:8000"
CHROMA_COLLECTION_PREFIX="eduai"

# --- Chunking engine -------------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# --- Rate limiting / misc --------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
