# Environment used by the `app` and `worker` services inside docker-compose.
# Hostnames refer to the Docker Compose service names (internal network), not localhost.

NODE_ENV=production
APP_URL=http://localhost:3000
PORT=3000

DATABASE_URL="postgresql://eduai:eduai_password@postgres:5432/eduai?schema=public"
REDIS_URL="redis://redis:6379"

JWT_ACCESS_SECRET="change-me-access-secret-change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret-change-me-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="/app/storage/uploads"
MAX_UPLOAD_SIZE_MB=50

OLLAMA_BASE_URL="http://ollama:11434"
OLLAMA_CHAT_MODEL="qwen3:8b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

CHROMA_URL="http://chromadb:8000"
CHROMA_COLLECTION_PREFIX="eduai"

CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
